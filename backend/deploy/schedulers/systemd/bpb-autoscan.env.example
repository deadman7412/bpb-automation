# Copy to /etc/default/bpb-autoscan and adjust values.

BPB_STATE_DIR=/var/lib/bpb-automation
BPB_LOG_DIR=/var/log/bpb-automation
BPB_HOST_LABEL=ubuntu-lts
BPB_UPDATE_MODE=cloudflare_api
BPB_SCAN_RETRIES=3
BPB_APPLY_RETRIES=3
BPB_RETRY_DELAY_MS=1000

# Required
BPB_SCAN_CMD=echo '{"status":"success","phase1_passed":10,"phase2_tested":5,"working_ips":["1.1.1.1"]}'

# Optional
# BPB_APPLY_CMD=echo "$BPB_WORKING_IPS_JSON"
